# ============================================================
# 途间 · Docker 部署环境变量模板
# 用法：cp deploy.env.example .env  然后填好下面的值
# 注意：这个 .env 只用于 docker compose，与 backend/.env、frontend/.env 无关
# ============================================================

# ---------- 后端必需 ----------
# DeepSeek 模型密钥（https://platform.deepseek.com）
LLM_API_KEY=
LLM_MODEL_ID=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com

# 高德「Web 服务」Key（https://console.amap.com  → 应用管理 → Web服务）
# 注意：这是给后端查询 POI/天气/路线用的，和下面的前端 JS Key 不是同一个，不能混用
# 如保留 IP 白名单，请填写部署服务器的实际固定公网出口 IP。见 AMAP_SETUP.md。
AMAP_API_KEY=

# ---------- 数据库（compose 内的 PostgreSQL 容器） ----------
# 密码请改成强密码，且只包含字母/数字（避免 URL 里特殊字符要转义的麻烦）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=langgraph_trip_planner

# ---------- 可选：Unsplash 图片（不填则行程不显示照片） ----------
UNSPLASH_ACCESS_KEY=

# ---------- 前端地图（高德「Web端(JS API)」Key） ----------
# 在 https://console.amap.com 单独创建「Web端(JS API)」类型的 Key，
# 并把服务器公网 IP 或域名填进该 Key 的「域名白名单」，否则地图会加载失败
VITE_AMAP_WEB_KEY=
VITE_AMAP_SECURITY_CODE=

# ---------- 跨域来源 ----------
# 前端和 API 走同源 nginx 反代，通常用 * 即可；如需严格可改成 https://你的域名
CORS_ORIGINS=*
